# Copy this file to `.env` (a hidden file) and edit the copy:
#     cp .env.example .env && chmod 600 .env && nano .env
# Unzipping a new version never touches `.env`, so your settings survive updates.
#
# Rules for this file: one KEY=value per line, comments only on their own lines (like these), and avoid the
# dollar sign in values. Put a value in double quotes if it contains spaces.

# --- Sign-ups -------------------------------------------------------------------------------------------------
# 0 = closed (normal). Set to 1 only while creating accounts, then set it back to 0 and run:
#     docker compose up -d
WH_ALLOW_REGISTRATION=0

# Optional. When sign-ups are open (1), people must also enter this phrase to create an account. Leave it empty
# for no code. Use a long phrase, and change it after you hand it out.
WH_REGISTER_CODE=

# --- Usually left alone ------------------------------------------------------------------------------------------
# The port on your Unraid server that the app answers on (your Cloudflare Tunnel points at it).
WH_PORT=5005

# Where the database and session key live on the server.
WH_DATA_DIR=/mnt/user/appdata/workhours

# 1 = cookies are https-only (needed behind the tunnel). Set 0 only to test over http on your home network.
WH_HTTPS=1
